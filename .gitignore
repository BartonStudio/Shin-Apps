# Build directories
build/
out/
cmake-build-*/

# IDE files
.vs/
.vscode/
.idea/
*.user

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# 原 Shin 仓库参考副本（构建不依赖；WebView2 宿主壳代码已落到 platform/host/）
third_party/Shin/

# 前端：依赖与 Vite 构建产物（由 pnpm / vite 生成）
# 刻意写成路径无关：ui/ 以后若搬到 apps/<app>/ui/，这里不必再回来改
node_modules/
dist/

# 本地工作区数据（AI 会话记忆、临时日志与截图），不入库
.workbuddy/

# 本地工作区临时文件（AI Happy Design 缓存 / playwright / CDP 调试脚本），不入库
.ahd-*.json
.playwright-cli/
cdp-diagnose.mjs
tmp-cdp-check.mjs

# 大文件测试 demo（几十 MB 的 .dem 回放文件），走本地资源，不入库
*.dem

# DemoViewer web（源自独立仓库，规则已并入此处；web/.gitignore 仍保留生效）
# 运行时临时产物 / 日志 / 系统文件 / 编译产物
apps/DemoViewer/web/tmp/
*.log
.DS_Store
Thumbs.db
apps/DemoViewer/web/cpp/**/*.exe
